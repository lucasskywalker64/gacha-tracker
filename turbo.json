{
    "$schema": "https://turbo.build/schema.json",
    "globalEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "DATABASE_AUTH_TOKEN",
        "REDIS_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "DISCORD_CLIENT_ID",
        "DISCORD_CLIENT_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
    ],
    "tasks": {
        "build": {
            "outputs": ["dist/**", ".svelte-kit/**"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "format": {},
        "typecheck": {},
        "test": {
            "cache": false
        }
    }
}
